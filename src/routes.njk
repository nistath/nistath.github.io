---
pagination:
  data: siteContent.routes
  size: 1
  alias: route
permalink: "{{ route.path }}/index.html"
---
{#- One redirect stub per registered route. GitHub Pages has no rewrites, so
    each clean path needs a real file that hands the requested route back to
    the shell. Generated from scripts/content/routes.cjs so a route that its
    content disables never gets a stub. -#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <title>{{ route.social.title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{{ route.theme }}">
  <meta name="author" content="Nick Stathas">
  <meta name="robots" content="index,follow">
  <link rel="canonical" href="{{ siteOrigin }}{{ route.path }}">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="mask-icon" href="/favicon.svg" color="#2b4557">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Nick Stathas">
  <meta property="og:title" content="{{ route.social.title }}">
  <meta property="og:url" content="{{ siteOrigin }}{{ route.path }}">
  <meta property="og:image" content="{{ siteOrigin }}{{ route.social.image }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ route.social.title }}">
  <meta property="og:locale" content="en_US">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ route.social.title }}">
  <meta name="twitter:image" content="{{ siteOrigin }}{{ route.social.image }}">
  <meta name="twitter:image:alt" content="{{ route.social.title }}">

  <script>
    (function() {
      try {
        location.replace('/?route=' + encodeURIComponent('{{ route.path }}'));
      } catch (err) {
        location.href = '/?route=' + encodeURIComponent('{{ route.path }}');
      }
    }());
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0;url=/">
  </noscript>
  <style>
    html, body { margin: 0; padding: 0; background: {{ route.theme }}; color: #e6edf3;
      font: 16px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    main { min-height: 100vh; display: grid; place-items: center; padding: 24px;
      text-align: center; }
    a { color: #68a7cb; }
  </style>
</head>
<body>
  <main>
    <div>
      <p>Loading {{ route.label }}…</p>
      <p><a href="/">Continue to nistath.com</a></p>
    </div>
  </main>
</body>
</html>
