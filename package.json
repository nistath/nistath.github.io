{
  "name": "nistath.github.io",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && npm run validate:content && eleventy",
    "check": "npm run build && node scripts/check-generated.cjs",
    "check:layout": "node scripts/check-layout.js",
    "clean": "node -e \"require('node:fs').rmSync('_site', { force: true, recursive: true })\"",
    "dev": "eleventy --serve --port=8080",
    "og": "npm run build && node scripts/render-og.js",
    "texture": "node scripts/render-shell-texture.cjs",
    "validate:content": "node scripts/validate-content.cjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "ajv": "^8.20.0",
    "markdown-it": "^14.3.0",
    "nunjucks": "^3.2.4",
    "pdfjs-dist": "^6.2.108",
    "playwright": "^1.56.1",
    "yaml": "^2.9.0"
  }
}
