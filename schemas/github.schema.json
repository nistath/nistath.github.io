{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "subtitle",
    "loading",
    "fallback",
    "pinned_repositories"
  ],
  "properties": {
    "title": { "$ref": "#/definitions/text" },
    "subtitle": { "$ref": "#/definitions/text" },
    "loading": { "$ref": "#/definitions/text" },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_unavailable", "no_description", "error"],
      "properties": {
        "metadata_unavailable": { "$ref": "#/definitions/text" },
        "no_description": { "$ref": "#/definitions/text" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message", "link"],
          "properties": {
            "message": { "$ref": "#/definitions/text" },
            "link": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "url"],
              "properties": {
                "label": { "$ref": "#/definitions/text" },
                "url": { "$ref": "#/definitions/url" }
              }
            }
          }
        }
      }
    },
    "pinned_repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
    }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "https-url" }
  }
}
