        {{ m.venue('&#x1F3D9;&#xFE0F;', 'Bios', 'Legendary rooftop bar on Pireos St. Deck chairs, DJs, incredible Acropolis views. Try the popsicle cocktail.', 'https://maps.app.goo.gl/i7qomXPkvD9t7DJ79') }}
        {{ m.venue('&#x1F3B6;', 'Drachmi', 'Lively cocktail bar on Kolokotroni Square. Packed on weekends. Great drinks, funky music, young crowd.', 'https://maps.app.goo.gl/dxBLrnwPHm3ZHs4k7') }}
        {{ m.venue('&#x1F9FA;', 'Πλυντήριο', 'Club themed as a laundromat. Fun, irreverent, young crowd.', 'https://maps.app.goo.gl/Z3bNF4B6Wus1hACc7', lang='el') }}
