        {{ m.venue('&#x1F969;', 'Basegrill Athens', 'One of Athens&#8217; best steakhouses. Premium cuts, egg nest potatoes, great wine list.', 'https://maps.app.goo.gl/TuuheUo7c9UeZJmS6') }}
