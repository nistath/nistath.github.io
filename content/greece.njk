<!-- ISLANDS DIVIDER -->
<div class="gr-islands-intro">
  <div class="gr-islands-eyebrow">Beyond Athens</div>
  <h2 class="gr-islands-title">Island Escapes</h2>
  <p class="gr-islands-sub">Each island has its own personality.</p>
</div>

<!-- MYKONOS -->
{{ m.islandHeader('mykonos', 'Mykonos', 'Glamorous, loud, and unapologetically fun', 'https://upload.wikimedia.org/wikipedia/commons/7/77/The_windmills_in_Mykonos%2C_Greece_-_50661524068.jpg', 'Mykonos windmills') }}
        <div class="gr-grid">
          <div class="gr-body">
            <p class="gr-p">Beach clubs, DJs, late nights, and beautiful people. But old town <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Mykonos+Chora" target="_blank" rel="noopener noreferrer">Chora</a> is genuinely charming, and there&#8217;s a real archaeological gem nearby.</p>
            <h3 class="gr-h3">Beaches</h3>
            <p class="gr-p">Good but below average by Greek island standards. You&#8217;re here for the scene. <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Paradise+Beach+Mykonos" target="_blank" rel="noopener noreferrer">Paradise</a> and <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Super+Paradise+Beach+Mykonos" target="_blank" rel="noopener noreferrer">Super Paradise</a> are more party than swim.</p>
            <h3 class="gr-h3">Don&#8217;t Miss</h3>
            <div class="gr-card gr-card--flush">
              {{ m.sight('Delos', 'Short boat ride &mdash; one of Greece&#8217;s most important archaeological sites. Birthplace of Apollo and Artemis. Visit with a guide.', mapHref='https://www.google.com/maps/search/?api=1&query=Delos+Archaeological+Site', ticketHref='https://hhticket.gr/') }}
              {{ m.sight('The Windmills', 'Iconic row overlooking the harbor. Classic photo spot, beautiful at sunset.', href='https://www.google.com/maps/search/?api=1&query=Mykonos+Windmills') }}
            </div>
            <h3 class="gr-h3">Eat &amp; Drink</h3>
            <div class="gr-venue-list">
              {{ m.venue('&#x1F426;', 'Pelican', 'Nick&#8217;s top pick for a meal on the island.', 'https://www.google.com/maps/search/?api=1&query=Pelican+Restaurant+Mykonos') }}
              {{ m.venue('&#x1F942;', 'Caprice', 'Sunset drinks on the water in Little Venice. Stunning views.', 'https://www.google.com/maps/search/?api=1&query=Caprice+Bar+Mykonos') }}
              {{ m.venue('&#x1F389;', 'Skandinavian', 'The go-to club for a big night out.', 'https://www.google.com/maps/search/?api=1&query=Skandinavian+Bar+Mykonos') }}
            </div>
          </div>
          <aside class="gr-aside">
            {{ m.tipList('&#x1F30A;', 'Essentials', 'essentials', [
              'Stay in old town <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Mykonos+Chora" target="_blank" rel="noopener noreferrer">Chora</a>, not beach hotels',
              'Visit <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Delos+Archaeological+Site" target="_blank" rel="noopener noreferrer">Delos</a> &mdash; don&#8217;t skip it',
              'Sunset drinks: <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Caprice+Bar+Mykonos" target="_blank" rel="noopener noreferrer">Caprice</a> in <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Little+Venice+Mykonos" target="_blank" rel="noopener noreferrer">Little Venice</a>',
              'Big night out: <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Skandinavian+Bar+Mykonos" target="_blank" rel="noopener noreferrer">Skandinavian</a>',
              'Best meal: <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Pelican+Restaurant+Mykonos" target="_blank" rel="noopener noreferrer">Pelican</a>'
            ]) }}
            {{ m.tipList('&#x1F6A2;', 'Getting There', 'ferry', [
              'Ferry from Piraeus: ~2.5&ndash;5 hrs',
              'Flight: ~45 min from ATH',
              'Book at <a href="https://ferryscanner.com" target="_blank" rel="noopener">ferryscanner.com</a>'
            ]) }}
          </aside>
        </div>
{{ m.islandFooter() }}

<!-- SANTORINI -->
{{ m.islandHeader('santorini', 'Santorini', 'Dramatic cliffs, legendary sunsets, real depth', 'https://commons.wikimedia.org/wiki/Special:FilePath/07-17-2012_-_Oia_-_Santorini_-_Greece_-_19.jpg?width=900', 'Oia blue domes at sunset, Santorini') }}
        <div class="gr-grid">
          <div class="gr-body">
            <p class="gr-p">Built on a volcanic caldera &mdash; cliffs into deep blue water, white buildings stacked together. Romantic, photogenic, historically rich.</p>
            <h3 class="gr-h3">Where to Stay</h3>
            <p class="gr-p"><a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Fira+Santorini" target="_blank" rel="noopener noreferrer"><strong>Fira</strong></a> is lively. <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Oia+Santorini" target="_blank" rel="noopener noreferrer"><strong>Oia</strong></a> is fancier with the iconic sunset. Stay along the caldera coast between them for a middle ground.</p>
            <h3 class="gr-h3">Things to Do</h3>
            <div class="gr-img" style="aspect-ratio:16/7;margin-bottom:12px">
              <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Hiking_Santorini_(7449565644).jpg?width=900" alt="Fira to Oia caldera hike" loading="lazy">
            </div>
            <div class="gr-card gr-card--flush">
              {{ m.sight('Oia Castle (Agios Nikolaos)', '15th-century Venetian fortress ruins. The sunset spot &mdash; arrive early.', href='https://www.google.com/maps/search/?api=1&query=Castle+of+Oia+Agios+Nikolaos+Santorini') }}
              {{ m.sight('Fira to Oia Hike', '~10 km caldera rim trail. Very little shade &mdash; go early, bring water.', href='https://www.google.com/maps/search/?api=1&query=Fira+to+Oia+Hike+Santorini') }}
              {{ m.sight('Akrotiri', 'Bronze Age settlement &mdash; the &#8220;Pompeii of the Aegean.&#8221; Over 3,500 years old.', mapHref='https://www.google.com/maps/search/?api=1&query=Akrotiri+Archaeological+Site+Santorini', ticketHref='https://hhticket.gr/') }}
              {{ m.sight('Ancient Thira', 'Hellenistic ruins on a ridge between Kamari and Perissa beaches.', mapHref='https://www.google.com/maps/search/?api=1&query=Ancient+Thera+Santorini', ticketHref='https://hhticket.gr/') }}
              {{ m.groupedSight('Museums in Fira', 'Good indoor stop before or after Akrotiri.', [
                {label: 'Fira', href: 'https://www.google.com/maps/search/?api=1&query=Fira+Santorini'},
                {label: 'Museum of Prehistoric Thera', href: 'https://www.google.com/maps/search/?api=1&query=Museum+of+Prehistoric+Thera+Fira'},
                {label: 'Archaeological Museum of Thera', href: 'https://www.google.com/maps/search/?api=1&query=Archaeological+Museum+of+Thera+Fira'}
              ]) }}
              {{ m.groupedSight('Red &amp; White Beach', 'Dramatic colored cliffs. Red Beach on foot, White Beach by boat.', [
                {label: 'Red Beach', href: 'https://www.google.com/maps/search/?api=1&query=Red+Beach+Santorini'},
                {label: 'White Beach', href: 'https://www.google.com/maps/search/?api=1&query=White+Beach+Santorini'}
              ]) }}
              {{ m.sight('Ammoudi Bay', 'Hidden harbor below Oia. Hike or donkey down for swimming and seafood.', href='https://www.google.com/maps/search/?api=1&query=Ammoudi+Bay+Santorini') }}
            </div>
            <h3 class="gr-h3">Eat &amp; Drink</h3>
            <div class="gr-venue-list">
              {{ m.venue('&#x1F959;', 'Yogi Gyro', 'In Fira &mdash; best gyros on the island.', 'https://www.google.com/maps/search/?api=1&query=Yogi+Gyro+Santorini') }}
              {{ m.venue('&#x1F305;', 'PK Cocktail Bar', 'The spot for sunset drinks.', 'https://www.google.com/maps/search/?api=1&query=PK+Cocktail+Bar+Santorini') }}
            </div>
          </div>
          <aside class="gr-aside">
            {{ m.tipList('&#x1F305;', 'Essentials', 'essentials', [
              'Stay in <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Oia+Santorini" target="_blank" rel="noopener noreferrer">Oia</a> for iconic sunset views',
              'Book caldera-view hotels early',
              'Hike <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Fira+to+Oia+Hike+Santorini" target="_blank" rel="noopener noreferrer">Fira &rarr; Oia</a> (10 km, go early)',
              'Visit <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Akrotiri+Archaeological+Site+Santorini" target="_blank" rel="noopener noreferrer">Akrotiri</a> archaeological site',
              'Sunset drinks: <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=PK+Cocktail+Bar+Santorini" target="_blank" rel="noopener noreferrer">PK Cocktail Bar</a>',
              'Best gyros: <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Yogi+Gyro+Santorini" target="_blank" rel="noopener noreferrer">Yogi Gyro</a> in <a class="gr-inline-link" href="https://www.google.com/maps/search/?api=1&amp;query=Fira+Santorini" target="_blank" rel="noopener noreferrer">Fira</a>'
            ]) }}
            {{ m.tipList('&#x1F6A2;', 'Getting There', 'ferry', [
              'Ferry from Piraeus: ~8 hrs (overnight)',
              'High-speed ferry: ~5 hrs',
              'Flight: ~45 min from ATH'
            ]) }}
          </aside>
        </div>
