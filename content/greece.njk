        'Loukoumades &mdash; honey-drizzled donuts',
        'Spanakopita &mdash; spinach &amp; feta pastry',
        'Greek yogurt with thyme honey',
        'Fresh seafood near Piraeus'
      ]) }}
      {{ m.tipList('&#x1F377;', 'Drink Like a Local', 'tips', [
        'Freddo espresso = iced espresso',
        'Tsipouro &mdash; the Greek grappa',
